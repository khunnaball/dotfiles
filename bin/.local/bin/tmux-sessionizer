#!/usr/bin/env bash
# tmux-sessionizer: pick a project directory, then open (or jump to)
# a tmux session named after it.
#
# Usage:
#   tmux-sessionizer            # fuzzy-pick from SEARCH_PATHS
#   tmux-sessionizer ~/dev/foo  # skip the picker

# Directories whose immediate subdirectories are your projects.
SEARCH_PATHS=(
    "$HOME/dev"
    "$HOME/work"
    "$HOME/gamedev"
)

# One-off directories to always include in the list.
EXTRA_DIRS=(
    "$HOME/dotfiles"
)

switch_to() {
    if [[ -z $TMUX ]]; then
        tmux attach-session -t "=$1"
    else
        tmux switch-client -t "=$1"
    fi
}

# Run a per-project (or global) setup file inside the new session.
hydrate() {
    local session=$1 dir=$2
    if [[ -f "$dir/.tmux-sessionizer" ]]; then
        tmux send-keys -t "$session" "source '$dir/.tmux-sessionizer'" Enter
    elif [[ -f "$HOME/.tmux-sessionizer" ]]; then
        tmux send-keys -t "$session" "source '$HOME/.tmux-sessionizer'" Enter
    fi
}

list_candidates() {
    local path
    for path in "${SEARCH_PATHS[@]}"; do
        [[ -d $path ]] && find "$path" -mindepth 1 -maxdepth 1 -type d
    done
    for path in "${EXTRA_DIRS[@]}"; do
        [[ -d $path ]] && echo "$path"
    done
}

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(list_candidates | fzf --border)
fi

[[ -z $selected ]] && exit 0

if [[ ! -d $selected ]]; then
    echo "tmux-sessionizer: not a directory: $selected" >&2
    exit 1
fi

# tmux uses . and : in target syntax, so they can't appear in session names.
name=$(basename "$selected" | tr .: __)

# has-session also fails when no tmux server is running, and
# new-session -d starts one, so this covers the "tmux not running" case too.
if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -ds "$name" -c "$selected"
    hydrate "$name" "$selected"
fi

switch_to "$name"

